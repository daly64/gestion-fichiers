<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Fond et barres système aux couleurs de l'application, sans flash blanc au démarrage -->
    <style name="Theme.GestionFichiers" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/fond_clair</item>
        <item name="android:colorAccent">@color/cobalt</item>
        <item name="android:statusBarColor">@color/fond_clair</item>
        <item name="android:navigationBarColor">@color/fond_clair</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>
</resources>
